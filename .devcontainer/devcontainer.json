{
  // vault-memory — Codespaces / VS Code dev container.
  //
  // Runs the whole stack inside the container via Docker-in-Docker: Postgres,
  // Weaviate, Ollama, and the FastAPI daemon on forwarded port 5051.
  //
  // Sizing: the GitHub Codespaces free tier gives 2-core / 8 GB / 32 GB and
  // 120 core-hours per month (~60 h on a 2-core box). That is enough because
  // the defaults below are deliberately small: a 1B Ollama model and the
  // MiniLM embedder/reranker instead of e5-large + mxbai (~4 GB of weights).
  // Bump EMBEDDING_MODEL / OLLAMA_MODEL once you are on a paid machine type.
  //
  // Rebuild the container after editing containerEnv; re-run
  // `.devcontainer/post-start.sh` to bring the stack back up.
  "name": "vault-memory (full stack)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  // The docker-in-docker feature already declares `privileged: true` for the
  // dev container, so no runArgs override is needed.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "VAULT_PATH": "/workspaces/sample-vault",
    "VAULT_MEMORY_PORT": "5051",
    "LLM_PROVIDER": "ollama",
    "OLLAMA_URL": "http://127.0.0.1:11434",
    "OLLAMA_MODEL": "llama3.2:1b",
    "WEAVIATE_URL": "http://127.0.0.1:8080",
    "PG_CONNECTION_STRING": "dbname=vault_memory user=vault password=vault_local host=127.0.0.1 port=5432",
    // Small, fast, 384-dim — keeps the free tier viable. Swapping either model
    // requires re-indexing (see USER_GUIDE.md "Model Upgrade").
    "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2",
    "RERANKER_MODEL": "cross-encoder/ms-marco-MiniLM-L-6-v2"
  },
  "forwardPorts": [5051, 8080, 11434],
  "portsAttributes": {
    "5051": {
      "label": "vault-memory daemon",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Weaviate",
      "onAutoForward": "silent"
    },
    "11434": {
      "label": "Ollama",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "postStartCommand": "sh .devcontainer/post-start.sh",
  "remoteUser": "vscode"
}
